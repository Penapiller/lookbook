---
import Base from '../layouts/Base.astro';
import sharp from 'sharp';
import path from 'node:path';
import { SITE_URL, HEIGHTS } from '../config.mjs';

export function getStaticPaths() {
  const modules = import.meta.glob('../content/pets/*.json', { eager: true });
  return Object.values(modules)
    .map((m) => m.default ?? m)
    .filter((p) => p.id && p.image)
    .map((pet) => ({ params: { id: String(pet.id) }, props: { pet } }));
}

const { pet } = Astro.props;
const id = String(pet.id);

// Read the real width of each generated size so we can show it.
const sizes = await Promise.all(
  HEIGHTS.map(async (h) => {
    let width = null;
    try {
      const meta = await sharp(path.join(process.cwd(), 'public/pets', `${id}-${h}.png`)).metadata();
      width = meta.width;
    } catch {}
    return { height: h, width, url: `${SITE_URL}/pets/${id}-${h}.png` };
  })
);
const pageUrl = `${SITE_URL}/${id}`;
const heroHeight = HEIGHTS.includes(500) ? 500 : HEIGHTS[0];
---
<Base title={`Pet ${id}`}>
  <a class="back" href="/lookbook">← Back to the Look Book</a>

  <div class="panel pet-layout">
    <div class="pet-image">
      <img src={`/pets/${id}-${heroHeight}.png`} alt={`Pet ${id} by ${pet.artist}`} />
    </div>

    <div>
      <div class="id-tag">#{id}</div>
      <p class="artist-tag"><span>Art by </span><a href={`/lookbook?q=${encodeURIComponent(pet.artist ?? '')}`}>{pet.artist}</a></p>

      <div class="bbcode-box">
        <h2>Copy BBCode</h2>
        <p class="help">Pick a size, press Copy, and paste it into your post.</p>

        <label class="linkback">
          <input type="checkbox" id="linkback" />
          <span>Make the image link back to this page</span>
        </label>

        <div id="sizes" data-page={pageUrl}>
          {sizes.map((s) => (
            <div class="size" data-url={s.url}>
              <div class="size-head">
                <span class="size-name">{s.height} px tall</span>
                {s.width && <span class="size-dims">{s.width} × {s.height} px</span>}
              </div>
              <div class="size-row">
                <code>[img]{s.url}[/img]</code>
                <button class="copy" type="button">Copy</button>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>

  <script>
    const box = document.getElementById('sizes');
    const toggle = document.getElementById('linkback');
    const page = box.dataset.page;

    function bbcode(url) {
      const img = `[img]${url}[/img]`;
      return toggle.checked ? `[url=${page}]${img}[/url]` : img;
    }
    function refresh() {
      box.querySelectorAll('.size').forEach((el) => {
        el.querySelector('code').textContent = bbcode(el.dataset.url);
      });
    }
    async function copyText(text) {
      try { await navigator.clipboard.writeText(text); }
      catch {
        const ta = document.createElement('textarea');
        ta.value = text; document.body.appendChild(ta); ta.select();
        document.execCommand('copy'); ta.remove();
      }
    }

    toggle.addEventListener('change', refresh);
    box.addEventListener('click', async (e) => {
      const btn = e.target.closest('.copy');
      if (!btn) return;
      const el = btn.closest('.size');
      await copyText(bbcode(el.dataset.url));
      btn.textContent = 'Copied!';
      btn.classList.add('done');
      setTimeout(() => { btn.textContent = 'Copy'; btn.classList.remove('done'); }, 1600);
    });
  </script>
</Base>
