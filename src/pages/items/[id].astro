---
// The dynamic segment here is named "id" for simplicity, but for items it
// actually holds the item's name-based page slug (see slug() below) —
// items don't have a separate ID field.
import Base from '../../layouts/Base.astro';
import { SITE_URL, PAGES, ITEM_IMAGE_HEIGHT, ITEM_IMAGE_DISPLAY_WIDTH } from '../../config.mjs';
import { bbcodeToHtml } from '../../bbcode.mjs';

export function getStaticPaths() {
  if (!PAGES.items) return [];

  function slug(file) {
    const base = file.split('/').pop().replace(/\.json$/, '').toLowerCase().trim();
    return base.replace(/[^a-z0-9]+/g, '-').replace(/(^-+|-+$)/g, '') || 'item';
  }

  const modules = import.meta.glob('../../content/items/*.json', { eager: true });
  return Object.entries(modules)
    .map(([file, m]) => ({ ...(m.default ?? m), slug: slug(file) }))
    .filter((it) => it.name && it.image)
    .map((item) => ({ params: { id: item.slug }, props: { item } }));
}

const { item } = Astro.props;
const bio = (item.bio ?? '').trim();
const bioHtml = bio ? bbcodeToHtml(bio) : '';
const imageUrl = `/items/${item.slug}-${ITEM_IMAGE_HEIGHT}.png`;
---
<Base
  title={item.name}
  description={item.artist ? `Made by ${item.artist}` : item.type}
  previewImage={imageUrl}
>
  <a class="back" href="/items">← Back to the Item Look Book</a>

  <div class="panel pet-layout">
    <div class="item-image" style={`--item-img-w:${ITEM_IMAGE_DISPLAY_WIDTH}px`}>
      <img src={imageUrl} alt={item.name} />
    </div>

    <div>
      <h1 class="item-name">{item.name}</h1>
      {item.type && <div class="type-tag">{item.type}</div>}
      {item.artist && (
        <p class="artist-tag"><span>Made by </span><a href={`/items?q=${encodeURIComponent(item.artist)}`}>{item.artist}</a></p>
      )}
      {bio && (
        <div class="bio-box">
          <h2>Information</h2>
          <p set:html={bioHtml} />
        </div>
      )}
    </div>
  </div>
</Base>

<style>
  .item-name { font-size: clamp(1.6rem, 4.5vw, 2.2rem); margin-bottom: 0.6rem; }

  /* The item's picture. Width comes from ITEM_IMAGE_DISPLAY_WIDTH in
     config.mjs (the --item-img-w variable set above), so it doesn't
     stretch to fill the column the way the pet picture does. */
  .item-image {
    display: grid;
    place-items: center;
    padding: 1rem;
    background: var(--tint);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }
  .item-image img {
    display: block;
    width: 100%;
    max-width: var(--item-img-w, 260px);
    height: auto;
  }

  /* A small pill-shaped tag, not a big heading like the pet ID tag. */
  .type-tag {
    display: inline-block;
    font-family: var(--body);
    font-weight: 700;
    font-size: 0.85rem;
    letter-spacing: 0.02em;
    color: var(--headings);
    padding: 0.3rem 0.7rem;
    border: 1.5px solid var(--headings);
    border-radius: 999px;
  }

  .bio-box {
    margin-top: 1rem;
    padding: 0.8rem 1rem 0.9rem;
    border: 2px solid var(--border);
    border-radius: var(--radius);
  }
  .bio-box h2 { font-size: 1.3rem; margin: 0 0 0.3rem; }
  .bio-box p { margin: 0; white-space: pre-line; overflow-wrap: anywhere; }
</style>
