---
import fs from 'node:fs';
import path from 'node:path';
import Base from '../layouts/Base.astro';
import { HOME, SITE_NAME } from '../config.mjs';

const hasImage = HOME.image && fs.existsSync(path.join(process.cwd(), 'public', HOME.image.replace(/^\//, '')));
---
<Base>
  <div class="panel home-card" style={`--promo-w:${HOME.imageWidth}px`}>
    {hasImage && <img src={HOME.image} alt={`${SITE_NAME} promo`} />}
    <div class="home-text">
      <h1>{HOME.title}</h1>
      {HOME.message.map((p) => <p set:html={p} />)}
    </div>
  </div>
</Base>
