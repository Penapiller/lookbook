---
import '../styles/global.css';
import fs from 'node:fs';
import path from 'node:path';
import { SITE_NAME, SITE_TAGLINE, SITE_URL, SITE_PREVIEW_IMAGE, FOOTER_TEXT, COLORS, HEADER, BACKGROUND, NAV_LINKS } from '../config.mjs';

// previewImage: a root-relative path (e.g. "/pets/014-500.png") for this
// specific page's social-media preview picture. If left out, the site's
// default SITE_PREVIEW_IMAGE is used instead.
const { title, description = SITE_TAGLINE, previewImage } = Astro.props;
const pageTitle = title ? `${title} | ${SITE_NAME}` : SITE_NAME;

// Does a file in /public exist? (used so missing images fail gracefully)
const has = (p) => !!p && fs.existsSync(path.join(process.cwd(), 'public', p.replace(/^\//, '')));

// ── Colors + background become CSS variables ──
const b = BACKGROUND;
let bg = `repeating-linear-gradient(${b.stripeAngle}deg, ${b.stripeColorA} 0 ${b.stripeWidth}px, ${b.stripeColorB} ${b.stripeWidth}px ${b.stripeWidth * 2}px)`;
let bgSize = 'auto';
let bgRepeat = 'repeat';
if (b.style === 'solid') {
  bg = b.solidColor;
} else if (b.style === 'image' && has(b.image)) {
  bg = `${COLORS.pageBackground} url("${b.image}")`;
  bgSize = b.imageFit === 'cover' ? 'cover' : 'auto';
  bgRepeat = b.imageFit === 'cover' ? 'no-repeat' : 'repeat';
}
const vars = `:root{
  --page: ${COLORS.pageBackground};
  --box: ${COLORS.boxBackground};
  --text: ${COLORS.text};
  --headings: ${COLORS.headings};
  --link: ${COLORS.links};
  --button: ${COLORS.buttons};
  --button-text: ${COLORS.buttonText};
  --bar: ${COLORS.bars};
  --bar-text: ${COLORS.barText};
  --border: ${COLORS.borders};
  --page-bg: ${bg};
  --page-bg-size: ${bgSize};
  --page-bg-repeat: ${bgRepeat};
}`;

// ── Header image ──
const headerOk = has(HEADER.image);

// ── Discord / social media preview card ──
const pagePreview = previewImage || (has(SITE_PREVIEW_IMAGE) ? SITE_PREVIEW_IMAGE : null);
const ogImage = pagePreview ? `${SITE_URL}${pagePreview}` : null;
const pageUrl = `${SITE_URL}${Astro.url.pathname.replace(/\/+$/, '') || '/'}`;

// ── Nav ──
// Pet pages live at the site root (e.g. /014) rather than under
// /lookbook, so the Look Book link should stay highlighted there too.
// This list is every section EXCEPT pets, kept separate from NAV_LINKS
// so it still works correctly even if Items/Rules/Artists are turned
// off in PAGES (and so their link disappears from the nav bar).
const path_ = Astro.url.pathname.replace(/\/+$/, '') || '/';
const topSegment = '/' + (path_.split('/')[1] ?? '');
const RESERVED_PATHS = ['/lookbook', '/items', '/rules', '/artists'];
const isPetPage = path_ !== '/' && !RESERVED_PATHS.includes(topSegment);

const links = NAV_LINKS.filter((l) => l.href).map((l) => ({
  ...l,
  active: !l.newTab && (topSegment === l.href || (l.href === '/lookbook' && isPetPage)),
}));
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🎃</text></svg>" />

    <!-- Discord / social media preview card -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="theme-color" content={COLORS.bars} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Almendra:wght@400;700&family=Alegreya+Sans:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet" />
    <style is:inline set:html={vars}></style>
  </head>
  <body>
    <div class="page">
      <header class="column">
        <a class:list={['header-box', { plain: !HEADER.colorBehind }]} href="/" aria-label={`${SITE_NAME} home`}>
          {headerOk
            ? <img src={HEADER.image} alt={SITE_NAME} style={`width:${HEADER.width}px`} />
            : <span class="header-text">{SITE_NAME}</span>}
        </a>
        <nav class="nav" aria-label="Main">
          <ul>
            {links.map((l) => (
              <li>
                <a
                  href={l.href}
                  aria-current={l.active ? 'page' : undefined}
                  target={l.newTab ? '_blank' : undefined}
                  rel={l.newTab ? 'noopener' : undefined}
                >{l.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      </header>

      <main class="column">
        <slot />
      </main>

      <footer class="footer">{FOOTER_TEXT}</footer>
    </div>
  </body>
</html>
